[Unit]
Description=Raspberry Pi Companion Computer - System Monitor and Watchdog
After=network.target companion-main.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/autonomous-armed-uav
Environment=PYTHONUNBUFFERED=1
Environment=RPI_COMPANION_ROOT=/home/pi/autonomous-armed-uav
ExecStart=/usr/bin/python3 /home/pi/autonomous-armed-uav/scripts/system_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
